# SYNORA runs fully offline in Demo Mode; no variables are required yet.
# Auth0 (later phase). Domain and client ID are public SPA config — never put secrets in VITE_ variables.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://synora-api.example
